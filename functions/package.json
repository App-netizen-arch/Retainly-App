{
  "name": "retainly-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Retainly",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js",
    "lint": "eslint \"src/**/*\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google-cloud/vision": "^4.3.3",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.0.1",
    "googleapis": "^144.0.0",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.2"
  },
  "private": true
}
